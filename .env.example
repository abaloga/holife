# ---------------------------------------------------------------------------
# HoLife: client environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# EVERYTHING IN THIS FILE IS PUBLIC. Vite inlines `VITE_*` variables into the
# JavaScript bundle that ships to the browser, so only publishable values may
# appear here. Server secrets live in Supabase Edge Function secrets. See the
# second section below, which is documentation, not variables this app reads.
# ---------------------------------------------------------------------------

# Supabase project URL.
# Dashboard → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable ("anon") key.
# Dashboard → Project Settings → API Keys → anon / public
# Safe to ship: it only grants what Row Level Security allows.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Product name used in the wordmark and the document title. Optional.
VITE_APP_NAME=HoLife


# ---------------------------------------------------------------------------
# Server-side secrets: DO NOT put these in this file or in any VITE_ variable
# ---------------------------------------------------------------------------
# Set them on the Edge Functions environment instead:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set OPENAI_MACRO_MODEL=gpt-5.6-luna
#   supabase secrets set ALLOWED_ORIGINS=https://holife.pages.dev,http://localhost:5173
#
#   OPENAI_API_KEY      Required for macro estimation. Without it the app still
#                       works; the estimator returns a clear "not configured"
#                       message and manual entry is unaffected.
#   OPENAI_MACRO_MODEL  Which model to use. Defaults to gpt-5.6-luna.
#   ALLOWED_ORIGINS     Comma-separated origins allowed to call the function.
#                       Unset means any origin, which is fine locally only.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected into Edge Functions by the
# platform, so you do not set those yourself.
#
# The service role key is not used anywhere in this project. If you ever add it,
# it belongs only in a server environment, never in the frontend.
# ---------------------------------------------------------------------------
